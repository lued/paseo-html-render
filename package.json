{
  "name": "paseo-html-render",
  "private": false,
  "version": "2.0.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:renderer": "node --test tests/renderer.test.ts",
    "check:bundles": "node scripts/check-bundles.mjs",
    "test:unit": "node --test tests/recognize.test.ts tests/artifacts.test.ts tests/authority.test.ts",
    "verify:e2e": "node --test --test-concurrency=1 tests/e2e/verify.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "Sandboxed live HTML, static previews and native reports for Paseo",
  "type": "module",
  "peerDependencies": {
    "@getpaseo/plugin": ">=0.12.0 <0.13.0"
  },
  "dependencies": {
    "pele": "1.7.0"
  }
}
