{
  "name": "paseo-html-render",
  "private": false,
  "version": "3.0.0",
  "description": "Live sandboxed HTML cards in the Paseo timeline, with static previews and native reports.",
  "license": "MIT",
  "author": "lued",
  "homepage": "https://github.com/lued/paseo-html-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lued/paseo-html-render.git"
  },
  "bugs": {
    "url": "https://github.com/lued/paseo-html-render/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "html",
    "reports",
    "timeline",
    "visualization",
    "productivity"
  ],
  "files": [
    "paseo-plugin.json",
    "README.md",
    "OVERVIEW.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "docs/compatibility.md",
    "docs/interactivity.md",
    "docs/release.md",
    "docs/showcase.md",
    "docs/images/showcase/",
    "examples/showcase/",
    "examples/interactive/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:renderer": "node --test tests/renderer.test.ts",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:client-eval": "node scripts/check-client-eval.mjs",
    "test:unit": "node --test tests/recognize.test.ts tests/artifacts.test.ts tests/authority.test.ts",
    "verify:e2e": "node --test --test-concurrency=1 tests/e2e/verify.test.ts",
    "check:trigger": "node scripts/trigger-eval.mjs",
    "check:package": "node scripts/check-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test:package": "node --test tests/package-metadata.test.ts tests/showcase-docs.test.ts tests/package-check.test.ts",
    "prepublishOnly": "npm run typecheck && npm run check:bundles && npm run check:package"
  },
  "devDependencies": {
    "@getpaseo/client": "0.14.0-beta.1",
    "@getpaseo/plugin": "0.14.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "@getpaseo/plugin": ">=0.14.0-beta.1 <0.15.0"
  },
  "dependencies": {
    "pele": "1.7.0"
  }
}
